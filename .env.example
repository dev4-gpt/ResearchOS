# ResearchingOS Environment Variables

# ── Gemini API (required for live runs) ──────────────────────────────────────
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Provider mode: auto (use live keys when present), dry_run (always synthetic), or live (fail if no provider is configured)
RESEARCHINGOS_RUN_MODE=auto

# Optional model overrides (defaults: gemini-2.0-flash for all agents)
# GEMINI_FLASH_MODEL=gemini-2.0-flash
# GEMINI_PRO_MODEL=gemini-2.0-pro-exp

# ── Vault ─────────────────────────────────────────────────────────────────────
# Path to the Obsidian Vault directory (relative to backend/ or absolute)
VAULT_PATH=../vault

# ── Backend server ────────────────────────────────────────────────────────────
PORT=8000
HOST=127.0.0.1

# ── OpenAlex / Crossref polite pool ──────────────────────────────────────────
# Add your real email so APIs route you to the polite (faster) pool
CONTACT_EMAIL=your_email@example.com

# Optional alphaXiv/OpenResearch retrieval (auto-detects .tools/openresearch/orx or PATH)
OPENRESEARCH_ENABLED=true
# OPENRESEARCH_BIN_PATH=/absolute/path/to/orx

# Optional Scout planning and discovery (both disabled by default)
SCOUT_NEBIUS_ENABLED=false
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=MiniMaxAI/MiniMax-M3
SCOUT_TAVILY_ENABLED=false
TAVILY_API_KEY=

# Reviewed research methods from the pinned local skill selection
RESEARCH_SKILLS_ENABLED=true

# Optional override for the connected dev4-gpt/blissful-bose research workspace
# VLM_RESEARCH_PATH=/absolute/path/to/blissful-bose

# Optional research engines: export these explicitly for the CLI (it does not load .env).
RESEARCH_ENGINES_ENABLED=false
# AlphaEvolve only: locally available Python image pinned by digest.
RESEARCH_ENGINE_IMAGE=

# Isolated manuscript generation; CLI requires explicitly exported configuration.
PAPERORCHESTRA_ENABLED=false
# Locally built writer image with Python dependencies and TeX, pinned by digest.
PAPERORCHESTRA_IMAGE=

# Single-operator deployment. Missing credentials fail closed at startup.
RESEARCHINGOS_ACCESS_MODE=authenticated
RESEARCHINGOS_OPERATOR=operator
# Generate a random secret of at least 32 characters; never commit the real value.
RESEARCHINGOS_PASSWORD=
RESEARCHINGOS_ORIGINS=https://research.example
RESEARCHINGOS_HOSTS=research.example,localhost,127.0.0.1
RESEARCHINGOS_COOKIE_SECURE=true
# Set absolute paths on private, backed-up local storage (not network/cloud-sync folders).
# RESEARCHINGOS_JOBS_DB=/srv/researchingos/state/jobs.sqlite3
# RESEARCHINGOS_PUBLISHER_DB=/srv/researchingos/state/publisher.sqlite3
# Required for authenticated-mode TeX compilation; no host fallback.
RESEARCHINGOS_TEX_IMAGE=
# For loopback development only: explicitly set RESEARCHINGOS_ACCESS_MODE=local.

# Shared cumulative reservation ledger REQUIRED for live AlphaEvolve/Harness2 calls.
# Preserve this file across processes/restarts; resetting it resets the spending history.
# This does not cover the legacy council or PaperOrchestra provider calls.
# RESEARCHINGOS_SPEND_LEDGER=/srv/researchingos/state/validation-spend.sqlite3
# RESEARCHINGOS_SPEND_CAP_USD=5

# Paid paths fail closed without a pre-existing shared ledger. No runtime creates
# a replacement allowance. Resolve a reviewed price ceiling before enabling a model.
# RESEARCHINGOS_GEMINI_APPROVED_MODELS=gemini-2.5-flash
# RESEARCHINGOS_GEMINI_TOKEN_PRICE_CEILING=10
# RESEARCHINGOS_GEMINI_MIN_INTERVAL=14
# RESEARCHINGOS_RESEARCH_JOB_SECONDS=900
# Each of GROQ, OPENROUTER, NIM and NEBIUS also requires its own
# RESEARCHINGOS_<PROVIDER>_APPROVED_MODELS and _TOKEN_PRICE_CEILING settings.
# RESEARCHINGOS_TAVILY_SEARCH_PRICE_CEILING=0.05
# Loopback endpoints can relay to paid hosts and use the same reservation path.
# RESEARCHINGOS_OLLAMA_APPROVED_MODELS=qwen3.5:4b
# RESEARCHINGOS_OLLAMA_TOKEN_PRICE_CEILING=100
# RESEARCHINGOS_REPRO_GEMMA_TOKEN_PRICE_CEILING=100
