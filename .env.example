# ResearchingOS Environment Variables

# ── Gemini API (required for live runs) ──────────────────────────────────────
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Provider mode: auto (use live keys when present), dry_run (always synthetic), or live (fail if no provider is configured)
RESEARCHINGOS_RUN_MODE=auto

# Optional model overrides (defaults: gemini-2.0-flash for all agents)
# GEMINI_FLASH_MODEL=gemini-2.0-flash
# GEMINI_PRO_MODEL=gemini-2.0-pro-exp

# ── Vault ─────────────────────────────────────────────────────────────────────
# Path to the Obsidian Vault directory (relative to backend/ or absolute)
VAULT_PATH=../vault

# ── Backend server ────────────────────────────────────────────────────────────
PORT=8000
HOST=127.0.0.1

# ── OpenAlex / Crossref polite pool ──────────────────────────────────────────
# Add your real email so APIs route you to the polite (faster) pool
CONTACT_EMAIL=your_email@example.com
