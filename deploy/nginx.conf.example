# Include inside nginx's http context. Replace hostname, certificate and static paths.
limit_req_zone $binary_remote_addr zone=operator_login:10m rate=5r/m;
server {
    listen 80;
    server_name research.example;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name research.example;
    ssl_certificate /etc/letsencrypt/live/research.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/research.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/researchingos/frontend/dist;
    client_max_body_size 10m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Strict-Transport-Security 'max-age=31536000' always;
    location = /api/session {
        limit_req zone=operator_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:18000;
        proxy_set_header Host $host;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:18000;
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_cache off;
    }
    # Never serve the vault directly: authentication is enforced by the API.
    location /vault/ {
        proxy_pass http://127.0.0.1:18000;
        proxy_set_header Host $host;
        proxy_cache off;
    }
    location / { try_files $uri $uri/ /index.html; }
}
